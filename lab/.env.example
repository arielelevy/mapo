# Azure OpenAI — direct HTTP, no SDK, no agent framework.
# Every variable is REQUIRED. There are no defaults: config.py raises on absence.

AZURE_OPENAI_ENDPOINT=https://innerbifoundry.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-chat
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Experiment control
# A float, or the literal 'model_default' to omit the parameter.
# gpt-5-chat rejects an explicit temperature; gpt-5.4-1 accepts 0.
# MAPO_TEMPERATURE se ELIMINO el 2026-08-29. Los modelos de razonamiento no aceptan
# `temperature` —la doc de Azure los lista bajo «Not Supported»— y dejarla viva fuera de la
# huella habria permitido promediar dos decodificaciones distintas en silencio.
#
# La reemplaza `MAPO_REASONING_EFFORT`: none | minimal | low | medium | high | xhigh | max,
# o vacio / `model_default` para dejar el del modelo.
#
# OJO CON `tools`: `gpt-5.6` y posteriores NO soportan tools junto con razonamiento en Chat
# Completions, y fallan aunque no se mande el parametro porque su default es `medium`. Todo
# paradigma de este banco es un bucle de herramientas, asi que sobre esos modelos hay que
# poner `none` —y entonces corren SIN razonar, que es otra medicion— o portar a Responses.
MAPO_REASONING_EFFORT=model_default
MAPO_SEED=7
MAPO_MAX_TOKENS=4096
MAPO_REQUEST_TIMEOUT=180
MAPO_CACHE_DIR=D:\Apps\lab\cache
MAPO_RESULTS_DIR=D:\Apps\lab\results
MAPO_CORPUS_DIR=D:\Apps\lab\corpus

# Embeddings live on a separate resource from chat.
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://innerbifoundry.cognitiveservices.azure.com
AZURE_OPENAI_EMBEDDING_API_KEY=

# Second model (gpt-5.4-nano on foundryopencode, eastus2). Used by _run_nano_*.py,
# which override endpoint/key/deployment and write to results/nano/.
MAPO_NANO_ENDPOINT=https://foundryopencode.cognitiveservices.azure.com
MAPO_NANO_KEY=
