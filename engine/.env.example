# Azure OpenAI — direct HTTP, no SDK, no agent framework.
# Every variable is REQUIRED. There are no defaults: config.py raises on absence.

AZURE_OPENAI_ENDPOINT=https://innerbifoundry.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-chat
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large

# Experiment control
# A float, or the literal 'model_default' to omit the parameter.
# gpt-5-chat rejects an explicit temperature; gpt-5.4-1 accepts 0.
PAPERLAB_TEMPERATURE=model_default
PAPERLAB_SEED=7
PAPERLAB_MAX_TOKENS=4096
PAPERLAB_REQUEST_TIMEOUT=180
PAPERLAB_CACHE_DIR=D:\Apps\paperlab\cache
PAPERLAB_RESULTS_DIR=D:\Apps\paperlab\results
PAPERLAB_CORPUS_DIR=D:\Apps\paperlab\corpus

# Embeddings live on a separate resource from chat.
AZURE_OPENAI_EMBEDDING_ENDPOINT=https://innerbifoundry.cognitiveservices.azure.com
AZURE_OPENAI_EMBEDDING_API_KEY=

# Second model (gpt-5.4-nano on foundryopencode, eastus2). Used by _run_nano_*.py,
# which override endpoint/key/deployment and write to results/nano/.
PAPERLAB_NANO_ENDPOINT=https://foundryopencode.cognitiveservices.azure.com
PAPERLAB_NANO_KEY=
